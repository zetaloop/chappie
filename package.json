{
	"name": "chappi",
	"version": "0.1.0",
	"description": "Connect ChatGPT to Pi",
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@types/node": "^26.5.1",
		"typebox": "^1.3.30",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"verify": "pnpm check",
		"format": "biome check --write .",
		"check": "biome check . && tsc"
	},
	"keywords": [
		"pi-package",
		"chatgpt",
		"mcp"
	],
	"author": "zetaloop",
	"license": "MIT",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.4.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.4.1",
	"type": "module",
	"engines": {
		"node": ">=26",
		"pnpm": ">=12"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	}
}

{
	"name": "@zetaloop/chappie",
	"version": "0.5.0",
	"description": "Connect ChatGPT to Pi",
	"devDependencies": {
		"@ai-sdk/provider": "^4.0.18",
		"@earendil-works/pi-ai": "^0.85.1",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@earendil-works/pi-tui": "^0.85.1",
		"@oh-my-pi/pi-ai": "^18.3.0",
		"@oh-my-pi/pi-coding-agent": "^18.3.0",
		"@oh-my-pi/pi-utils": "^18.3.0",
		"@opencode-ai/plugin": "^1.18.32",
		"@opencode-ai/sdk": "^1.18.32",
		"@types/node": "^26.5.1",
		"typebox": "^1.3.30",
		"typescript": "^7.0.2"
	},
	"scripts": {
		"format": "biome check --write .",
		"check": "biome check . && tsc --noEmit",
		"build": "tsc && node scripts/build.ts",
		"prepack": "pnpm build"
	},
	"keywords": [
		"pi-package",
		"chatgpt",
		"mcp"
	],
	"author": "zetaloop",
	"license": "MIT",
	"packageManager": "pnpm@12.4.1",
	"type": "module",
	"engines": {
		"node": ">=26",
		"pnpm": ">=12"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@oh-my-pi/pi-ai": "*",
		"@oh-my-pi/pi-coding-agent": "*",
		"@oh-my-pi/pi-utils": "*",
		"typebox": "*"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.0.0",
		"mime": "^4.1.0",
		"zod": "^4.6.4"
	},
	"files": [
		"dist",
		"docs"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zetaloop/chappie.git"
	},
	"bin": {
		"chappie": "./dist/cli.js"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		},
		"@oh-my-pi/pi-ai": {
			"optional": true
		},
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		},
		"@oh-my-pi/pi-utils": {
			"optional": true
		}
	},
	"omp": {
		"extensions": [
			"./dist/omp.js"
		]
	},
	"exports": {
		".": "./dist/index.js",
		"./server": "./dist/opencode.js"
	}
}

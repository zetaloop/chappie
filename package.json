{
	"name": "@zetaloop/chappie",
	"version": "1.2.0-alpha.2",
	"description": "Connect ChatGPT and coding agents across devices",
	"devDependencies": {
		"@ai-sdk/provider": "^4.0.38",
		"@earendil-works/pi-ai": "^1.5.2",
		"@earendil-works/pi-coding-agent": "^1.5.2",
		"@earendil-works/pi-tui": "^1.5.2",
		"@modelcontextprotocol/server": "^2.4.0",
		"@oh-my-pi/pi-ai": "^18.20.2",
		"@oh-my-pi/pi-coding-agent": "^18.20.2",
		"@oh-my-pi/pi-utils": "^18.20.2",
		"@opencode/client": "^2.3.0",
		"@opencode/plugin": "^2.3.0",
		"@opentui/solid": "^0.9.1",
		"@types/cross-spawn": "^6.0.6",
		"@types/node": "^26.6.6",
		"@types/ws": "^8.18.2",
		"cross-spawn": "^7.0.6",
		"esbuild": "^0.28.2",
		"mime": "^4.1.2",
		"solid-js": "^1.9.19",
		"typebox": "^1.4.7",
		"typescript": "^7.0.2",
		"ws": "^8.23.0",
		"zod": "^4.6.7"
	},
	"scripts": {
		"format": "biome check --write .",
		"check": "biome check . && tsc --noEmit",
		"build": "node scripts/build.ts",
		"prepack": "pnpm build"
	},
	"keywords": [
		"pi-package",
		"chatgpt",
		"mcp"
	],
	"author": "zetaloop",
	"license": "MIT",
	"packageManager": "pnpm@12.4.1",
	"type": "module",
	"engines": {
		"node": ">=26",
		"pnpm": ">=12"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@oh-my-pi/pi-ai": "*",
		"@oh-my-pi/pi-coding-agent": "*",
		"@oh-my-pi/pi-utils": "*",
		"@opentui/solid": "^0.9.1",
		"solid-js": "^1.9.19"
	},
	"files": [
		"dist",
		"docs",
		".codex-plugin"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zetaloop/chappie.git"
	},
	"bin": {
		"chappie": "./dist/cli.js"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"@oh-my-pi/pi-ai": {
			"optional": true
		},
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		},
		"@oh-my-pi/pi-utils": {
			"optional": true
		},
		"@opentui/solid": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		}
	},
	"omp": {
		"extensions": [
			"./dist/omp.js"
		]
	},
	"exports": {
		".": "./dist/index.js",
		"./server": "./dist/opencode.js",
		"./tui": "./dist/opencode-tui.js"
	}
}
